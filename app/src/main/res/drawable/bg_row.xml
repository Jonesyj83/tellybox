<?xml version="1.0" encoding="utf-8"?>
<!-- Standard list row on the right of a section: same focus language as the category rows. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><solid android:color="@color/surface_focus" /><corners android:radius="4dp" /></shape></item>
            <item android:width="3dp" android:gravity="left"><shape><solid android:color="@color/accent" /><corners android:topLeftRadius="4dp" android:bottomLeftRadius="4dp" /></shape></item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="@color/surface_raised" /><corners android:radius="4dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface" /><corners android:radius="4dp" /></shape>
    </item>
</selector>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/surface_focus" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="@color/surface_raised" /><corners android:radius="4dp" /></shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /></shape></item>
</selector>

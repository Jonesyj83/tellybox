<?xml version="1.0" encoding="utf-8"?>
<!-- Poster cards: nothing at rest, the soft focus fill with an accent edge under focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/surface_focus" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="@dimen/corner" />
        </shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /><corners android:radius="@dimen/corner" /></shape></item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:use_controller="false" />


    <!-- channel banner, shown on start and when zapping -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/overscan_h"
        android:layout_marginEnd="@dimen/overscan_h"
        android:layout_marginBottom="@dimen/overscan_v"
        android:background="#D9171B22"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bannerNumber"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:textColor="@color/accent" />

            <ImageView
                android:id="@+id/bannerLogo"
                android:layout_width="96dp"
                android:layout_height="54dp"
                android:layout_marginEnd="16dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bannerName"
                    style="@style/Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/bannerProgram"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bannerClock"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/bannerSleep"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

        <!-- why a live channel isn't timeshifted, when it is switched on -->
        <TextView
            android:id="@+id/timeshiftNote"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/timeshiftPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.tellybox.tv.ui.player.TimeshiftBar
                android:id="@+id/timeshiftBar"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <LinearLayout
                android:id="@+id/timeshiftControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tsRewind"
                    style="@style/Button.TV.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_watch_button"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/action_ts_rewind"
                    android:textColor="@color/text_primary"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/tsPause"
                    style="@style/Button.TV.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_watch_button"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/action_ts_pause"
                    android:textColor="@color/text_primary"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/tsSkip"
                    style="@style/Button.TV.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_watch_button"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/action_ts_skip"
                    android:textColor="@color/text_primary"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/tsLive"
                    style="@style/Button.TV.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_watch_button"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/action_ts_live"
                    android:textColor="@color/text_primary"
                    android:focusable="true"
                    android:clickable="true" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tsPosition"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cornerButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sleepButton"
            style="@style/Button.TV.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_watch_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/action_sleep"
            android:textColor="@color/text_primary"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/recordButton"
            style="@style/Button.TV.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_watch_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/action_record"
            android:textColor="@color/text_primary"
            android:visibility="gone"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#D9171B22"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_error" />

        <TextView
            android:id="@+id/errorDetail"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxWidth="560dp"
            android:gravity="center" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/player_retry" />
    </LinearLayout>
</FrameLayout>

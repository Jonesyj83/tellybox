<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="44dp" android:layout_marginBottom="6dp"
    android:background="@drawable/bg_focusable" android:clickable="true"
    android:focusable="true" android:orientation="vertical" android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/choiceTitle" style="@style/Text.Body"
            android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" />
        <TextView android:id="@+id/choiceDesc" style="@style/Text.Caption"
            android:textSize="16sp" android:textColor="@color/text_secondary"
            android:gravity="end" android:maxWidth="340dp" android:layout_marginStart="20dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView android:id="@+id/description" style="@style/Text.Caption"
        android:textSize="14sp" android:layout_marginTop="4dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="120dp"
            android:paddingTop="@dimen/overscan_v"
            android:paddingEnd="120dp"
            android:paddingBottom="@dimen/overscan_v">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_title" />

            <!-- step 1 -->
            <LinearLayout
                android:id="@+id/typeStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/add_choose_type"
                    android:textColor="@color/text_secondary" />

                <include android:id="@+id/typeM3uUrl" layout="@layout/item_choice" />
                <include android:id="@+id/typeM3uFile" layout="@layout/item_choice" />
                <include android:id="@+id/typeXtream" layout="@layout/item_choice" />
                <include android:id="@+id/typeStalker" layout="@layout/item_choice" />
            </LinearLayout>

            <!-- step 2 -->
            <LinearLayout
                android:id="@+id/formStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/formType"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="@color/accent" />

                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/field_name" />
                <EditText
                    android:id="@+id/nameInput"
                    style="@style/Input.TV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:inputType="text" />

                <LinearLayout
                    android:id="@+id/fileGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/field_file" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/pickFileButton"
                            style="@style/Button.TV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:text="@string/field_file_pick" />

                        <TextView
                            android:id="@+id/fileLabel"
                            style="@style/Text.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:text="@string/field_file_none" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/urlLabel"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_url" />
                <EditText
                    android:id="@+id/urlInput"
                    style="@style/Input.TV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:inputType="textUri" />

                <LinearLayout
                    android:id="@+id/credentialsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/field_username" />
                    <EditText
                        android:id="@+id/usernameInput"
                        style="@style/Input.TV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:inputType="text" />

                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/field_password" />
                    <EditText
                        android:id="@+id/passwordInput"
                        style="@style/Input.TV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:inputType="textVisiblePassword" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/macGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/field_mac" />
                    <EditText
                        android:id="@+id/macInput"
                        style="@style/Input.TV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/field_mac_hint"
                        android:inputType="textCapCharacters" />

                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/field_stb_type" />
                    <TextView
                        android:id="@+id/stbTypeButton"
                        android:ellipsize="end"
                        style="@style/Input.TV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:text="@string/stb_type_default" />

                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/field_serial" />
                    <EditText
                        android:id="@+id/serialInput"
                        style="@style/Input.TV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/field_serial_hint"
                        android:inputType="textCapCharacters" />

                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/field_device_id" />
                    <EditText
                        android:id="@+id/deviceIdInput"
                        style="@style/Input.TV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/field_device_id_hint"
                        android:inputType="textCapCharacters" />

                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/field_device_id2" />
                    <EditText
                        android:id="@+id/deviceId2Input"
                        style="@style/Input.TV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/field_device_id2_hint"
                        android:inputType="textCapCharacters" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/epgGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/field_epg" />
                    <EditText
                        android:id="@+id/epgInput"
                        style="@style/Input.TV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/field_epg_hint"
                        android:inputType="textUri" />
                </LinearLayout>

                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/field_user_agent" />
                <EditText
                    android:id="@+id/userAgentInput"
                    style="@style/Input.TV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:imeOptions="actionDone"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/formError"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/error"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/saveButton"
                        style="@style/Button.TV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="@string/action_save" />

                    <Button
                        android:id="@+id/backButton"
                        style="@style/Button.TV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_back" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60E1116"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading_playlist" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- The one left rail every section screen shares. Bound by SectionRail. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/rail_width"
    android:layout_height="match_parent"
    android:background="@color/rail_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="14dp">
    <LinearLayout
        android:id="@+id/brandMark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:importantForAccessibility="no">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato_light"
            android:includeFontPadding="false"
            android:text="@string/brand_first"
            android:textColor="@color/text_primary"
            android:textSize="9sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/lato_black"
            android:includeFontPadding="false"
            android:text="@string/brand_second"
            android:textColor="@color/accent"
            android:textSize="9sp" />
    </LinearLayout>
    <TextView android:id="@+id/railLive" style="@style/Rail.Item"
        android:drawableTop="@drawable/ic_menu_live" android:text="@string/rail_live" android:contentDescription="@string/rail_desc_live_tv" />
    <TextView android:id="@+id/railMovies" style="@style/Rail.Item"
        android:drawableTop="@drawable/ic_menu_movies" android:text="@string/rail_movies" android:contentDescription="@string/rail_desc_movies_and_series" />
    <TextView android:id="@+id/railRecordings" style="@style/Rail.Item"
        android:drawableTop="@drawable/ic_menu_recordings" android:text="@string/rail_recordings" android:contentDescription="@string/recordings_title" />
    <TextView android:id="@+id/railReminders" style="@style/Rail.Item"
        android:drawableTop="@drawable/ic_menu_reminders" android:text="@string/rail_reminders" android:contentDescription="@string/reminders_title" />
    <TextView android:id="@+id/railSearch" style="@style/Rail.Item"
        android:drawableTop="@drawable/ic_menu_search" android:text="@string/rail_search" android:contentDescription="@string/action_search" />
    <TextView android:id="@+id/railMultiview" style="@style/Rail.Item"
        android:drawableTop="@drawable/ic_menu_multiview" android:text="@string/rail_multiview" android:contentDescription="@string/multiview" />
    <TextView android:id="@+id/railPlaylists" style="@style/Rail.Item"
        android:drawableTop="@drawable/ic_menu_playlists" android:text="@string/rail_playlists" android:contentDescription="@string/playlists_title" />

    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/railSettings" style="@style/Rail.Item"
        android:drawableTop="@drawable/ic_menu_settings" android:text="@string/rail_settings" android:contentDescription="@string/settings_title" />
</LinearLayout>
